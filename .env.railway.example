# Railway Environment Variables Template
# Copy these to your Railway project's environment variables

# ============================================
# CORE APPLICATION
# ============================================
PORT=8080
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=futurefrontier
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
SECURE_COOKIES=true
CORS_ORIGINS=https://your-frontend.vercel.app,https://your-domain.com

# ============================================
# ELASTICSEARCH (ELASTIC CLOUD)
# ============================================
ELASTICSEARCH_URL=https://your-deployment.es.us-central1.gcp.cloud.es.io:443
ELASTICSEARCH_API_KEY=your-elastic-cloud-api-key-here
LOG_PROJECT_ID=futurefrontier
LOG_LOCAL_MODE=false
LOG_ENABLE_REQUEST_BODY=false
LOG_ENABLE_RESPONSE_BODY=false
LOG_ENABLE_HEADERS=false

# ============================================
# GOOGLE CLOUD VERTEX AI
# ============================================
GCP_PROJECT_ID=grand-principle-475206-b5
GCP_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.0-flash-exp
GOOGLE_APPLICATION_CREDENTIALS=<base64-encoded-service-account-json>

# To encode service account JSON:
# base64 -i service-account-key.json | tr -d '\n'
# Then paste the output above

# ============================================
# OPTIONAL: SMTP CONFIGURATION
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=FutureFrontier
SMTP_FROM_EMAIL=noreply@yourdomain.com

# ============================================
# OPTIONAL: SUPER ADMIN
# ============================================
SUPERADMIN_EMAIL=admin@yourdomain.com
SUPERADMIN_PASSWORD=change-this-secure-password
